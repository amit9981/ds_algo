Reverse K set of group ex:3
    Given Input :int[] nums = {1,2,3,4,5,6};
    Output : {3,2,1,6,5,4}

  public static void reverseKGroupSet(int[] arr, int k) {
         for (int i = 0; i < arr.length; i += k) {
             int left = i;
             int right = Math.min(i + k - 1, arr.length - 1);
           while (left < right) {
                 int temp = arr[left];
                 arr[left] = arr[right];
                 arr[right] = temp;
                 left++;
                 right--;
             }
         }
     }
