        for (int i = 0; i < sortedArr.length; i++) {
            for (int j = i + 1; j < sortedArr.length; j++) {
                flag = false;
                if (sortedArr[j] - sortedArr[i] == 0) {
                    flag = true;
                    break;
                }
            }
            if (flag) {
                i++;
            }
            dArr[z] = sortedArr[i];
            z++;
        }
        return dArr;
    }


