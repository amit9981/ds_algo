public static void shiftingLeftToRight(){
        int[] arr = { -1, 2, -3, 4, 5, 6, -7, 8, 9 };
        int negativeIndex = 0;
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] < 0) {
                int temp = arr[i];
                // Shift elements right
                for (int j = i; j > negativeIndex; j--) {
                    arr[j] = arr[j - 1];
                }
                arr[negativeIndex] = temp;
                negativeIndex++;
            }
  }
